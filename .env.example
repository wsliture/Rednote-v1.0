# Optional shell environment for scripts; actual credentials must stay untracked.
# Defaults: MySQL 8 at 127.0.0.1:3306/rednote_v1, user root.
# IDEA also reads rednote.dev.db.password from ignored .env.dev.properties.
REDNOTE_DB_USER=root
REDNOTE_DB_PASSWORD=your-local-password
# REDNOTE_DB_URL=jdbc:mysql://127.0.0.1:3306/rednote_v1?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
# Optional dev overrides:
# REDNOTE_DEV_DB_USER=root
# REDNOTE_DEV_DB_PASSWORD=your-local-password
# Optional one-time admin initialization; never commit real credentials.
# REDNOTE_ADMIN_USERNAME=your-admin-name
# REDNOTE_ADMIN_PASSWORD=your-strong-password
