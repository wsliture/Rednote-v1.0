# Copy to deploy/docker/deploy.env, or run scripts/docker.sh init.
# Generated passwords use hex to avoid Compose interpolation/quoting ambiguities.
REDNOTE_PROJECT_NAME=rednote
REDNOTE_IMAGE_TAG=local
REDNOTE_BIND_ADDRESS=0.0.0.0
REDNOTE_HTTP_PORT=80
REDNOTE_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDNOTE_COOKIE_SECURE=false
REDNOTE_FORWARD_HEADERS_STRATEGY=none
REDNOTE_JAVA_OPTIONS='-XX:MaxRAMPercentage=65.0'

# For a 2 GiB host, set the app limit to 1024m; 4 GiB+ recommended.
REDNOTE_APP_MEMORY_LIMIT=1536m
REDNOTE_DB_MEMORY_LIMIT=512m

# Optional trusted registry prefix, ending with / (empty = Docker Hub).
REDNOTE_IMAGE_PREFIX=

# Set 0.0.0.0 to allow remote database connections.
REDNOTE_DB_BIND_ADDRESS=127.0.0.1
REDNOTE_DB_PORT=3306
